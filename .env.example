# Sentinel-AI Environment Configuration Example

# Frontend settings (set in Vercel environment variables)
VITE_API_BASE_URL=http://localhost:8000

# Backend settings (set in Render environment variables)
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=*
SECRET_SALT=sentinel-secure-salt-key-9281

# Supabase Database Configuration (Get from Supabase Dashboard -> Project Settings -> API)
# Paste these in Render environment variables and your local .env
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
